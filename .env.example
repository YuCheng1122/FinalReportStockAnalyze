#Database (Postgres)
# Preferred: a single connection string (e.g. from Supabase/Neon/Render Postgres)
DATABASE_URL=
# Fallback: discrete connection fields, used only if DATABASE_URL is not set
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=5432
# Set to "disable" only for a local Postgres without SSL (e.g. local Docker testing)
PGSSLMODE=

JWT_SECRET_KEY=
SERP_API_KEY=
OPENAI_API_KEY=
